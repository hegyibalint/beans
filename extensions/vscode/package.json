{
  "name": "beans-vscode",
  "displayName": "Beans",
  "description": "Beans LSP client for JVM languages",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "publisher": "beans",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:java",
    "workspaceContains:**/*.java",
    "workspaceContains:**/beans.toml"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Gradle import executes the workspace's build scripts."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "beans.import.gradle",
        "title": "Beans: Import Gradle project"
      }
    ],
    "configuration": {
      "title": "Beans",
      "properties": {
        "beans.javaHome": {
          "type": "string",
          "default": "",
          "description": "JDK home (Java 17+) for the Beans sidecar. Gradle also uses it by default unless the project selects a daemon JVM. Defaults to JAVA_HOME. Restart Beans after changing this."
        }
      }
    },
    "languages": [
      {
        "id": "java",
        "extensions": [
          ".java"
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.test.cjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
